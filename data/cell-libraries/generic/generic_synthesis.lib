library (generic) {
	comment  : "Copyright (c) 2025 Tobias Faller; SPDX-License-Identifier: MIT";
	date     : "2025.05.05 14:45";
	revision : "version 0.1";

	cell (BUF) {
		area : 2.0;
		pin (IN1) {
			direction : input;
		}
		pin (OUT) {
			direction : output;
			function : "IN1";
		}
		pg_pin (VDD) {
			voltage_name : VDD;
			pg_type : primary_power;
		}
		pg_pin (VSS) {
			voltage_name : VSS;
			pg_type : primary_ground;
		}
	}

	cell (INV) {
		area : 1.0;
		pin (IN1) {
			direction : input;
		}
		pin (OUT) {
			direction : output;
			function : "!IN1";
		}
		pg_pin (VDD) {
			voltage_name : VDD;
			pg_type : primary_power;
		}
		pg_pin (VSS) {
			voltage_name : VSS;
			pg_type : primary_ground;
		}
	}

	cell (AND) {
		area : 3.0;
		pin (IN1) {
			direction : input;
		}
		pin (IN2) {
			direction : input;
		}
		pin (OUT) {
			direction : output;
			function : "(IN1 & IN2)";
		}
		pg_pin (VDD) {
			voltage_name : VDD;
			pg_type : primary_power;
		}
		pg_pin (VSS) {
			voltage_name : VSS;
			pg_type : primary_ground;
		}
	}

	cell (NAND) {
		area : 2.0;
		pin (IN1) {
			direction : input;
		}
		pin (IN2) {
			direction : input;
		}
		pin (OUT) {
			direction : output;
			function : "!(IN1 & IN2)";
		}
		pg_pin (VDD) {
			voltage_name : VDD;
			pg_type : primary_power;
		}
		pg_pin (VSS) {
			voltage_name : VSS;
			pg_type : primary_ground;
		}
	}

	cell (OR) {
		area : 3.0;
		pin (IN1) {
			direction : input;
		}
		pin (IN2) {
			direction : input;
		}
		pin (OUT) {
			direction : output;
			function : "(IN1 | IN2)";
		}
		pg_pin (VDD) {
			voltage_name : VDD;
			pg_type : primary_power;
		}
		pg_pin (VSS) {
			voltage_name : VSS;
			pg_type : primary_ground;
		}
	}

	cell (NOR) {
		area : 2.0;
		pin (IN1) {
			direction : input;
		}
		pin (IN2) {
			direction : input;
		}
		pin (OUT) {
			direction : output;
			function : "!(IN1 | IN2)";
		}
		pg_pin (VDD) {
			voltage_name : VDD;
			pg_type : primary_power;
		}
		pg_pin (VSS) {
			voltage_name : VSS;
			pg_type : primary_ground;
		}
	}

	cell (XOR) {
		area : 3.0;
		pin (IN1) {
			direction : input;
		}
		pin (IN2) {
			direction : input;
		}
		pin (OUT) {
			direction : output;
			function : "(IN1 ^ IN2)";
		}
		pg_pin (VDD) {
			voltage_name : VDD;
			pg_type : primary_power;
		}
		pg_pin (VSS) {
			voltage_name : VSS;
			pg_type : primary_ground;
		}
	}

	cell (XNOR) {
		area : 2.0;
		pin (IN1) {
			direction : input;
		}
		pin (IN2) {
			direction : input;
		}
		pin (OUT) {
			direction : output;
			function : "!(IN1 ^ IN2)";
		}
		pg_pin (VDD) {
			voltage_name : VDD;
			pg_type : primary_power;
		}
		pg_pin (VSS) {
			voltage_name : VSS;
			pg_type : primary_ground;
		}
	}

	cell (MUX) {
		area : 6.0;
		pin (IN1) {
			direction : input;
		}
		pin (IN2) {
			direction : input;
		}
		pin (IN3) {
			direction : input;
		}
		pin (OUT) {
			direction : output;
			function : "((!IN3 & IN1) | (IN3 & IN2))";
		}
		pg_pin (VDD) {
			voltage_name : VDD;
			pg_type : primary_power;
		}
		pg_pin (VSS) {
			voltage_name : VSS;
			pg_type : primary_ground;
		}
	}

	cell (DL) {
		area : 6.0;
		latch (IQ , IQN) {
			enable : "ENABLE";
			data_in : "IN1";
		}
		pin (IN1) {
			direction : input;
			data_in_type : data;
		}
		pin (ENABLE) {
			direction : input;
		}
		pin (OUT) {
			direction : output;
			function : "IQ";
		}
		pg_pin (VDD) {
			voltage_name : VDD;
			pg_type : primary_power;
		}
		pg_pin (VSS) {
			voltage_name : VSS;
			pg_type : primary_ground;
		}
	}

	cell (DLR) {
		area : 7.0;
		latch (IQ , IQN) {
			enable  : "ENABLE";
			data_in : "IN1";
			clear   : "ARESET";
		}
		pin (IN1) {
			direction : input;
			data_in_type : data;
		}
		pin (ENABLE) {
			direction : input;
		}
		pin (ARESET) {
			direction : input;
			data_in_type : clear;
		}
		pin (OUT) {
			direction : output;
			function : "IQ";
		}
		pg_pin (VDD) {
			voltage_name : VDD;
			pg_type : primary_power;
		}
		pg_pin (VSS) {
			voltage_name : VSS;
			pg_type : primary_ground;
		}
	}

	cell (DFF) {
		area : 11.0;
		ff (IQ , IQN) {
			clocked_on : "CLOCK";
			next_state : "IN1";
		}
		pin (IN1) {
			direction : input;
			nextstate_type : data;
		}
		pin (CLOCK) {
			direction : input;
			clock     : true;
		}
		pin (OUT) {
			direction : output;
			function : "IQ";
		}
		pg_pin (VDD) {
			voltage_name : VDD;
			pg_type : primary_power;
		}
		pg_pin (VSS) {
			voltage_name : VSS;
			pg_type : primary_ground;
		}
	}

	cell (DFFR) {
		area : 13.0;
		ff (IQ , IQN) {
			clocked_on : "CLOCK";
			next_state : "IN1";
			clear      : "ARESET";
		}
		pin (IN1) {
			direction : input;
			nextstate_type : data;
		}
		pin (CLOCK) {
			direction : input;
			clock     : true;
		}
		pin (ARESET) {
			direction : input;
			nextstate_type : clear;
		}
		pin (OUT) {
			direction : output;
			function : "IQ";
		}
		pg_pin (VDD) {
			voltage_name : VDD;
			pg_type : primary_power;
		}
		pg_pin (VSS) {
			voltage_name : VSS;
			pg_type : primary_ground;
		}
	}

}
